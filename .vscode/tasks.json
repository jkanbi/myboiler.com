{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "live-server",
      "type": "shell",
      "command": "npm run serve",
      "isBackground": true,
      "problemMatcher": {
        "owner": "live-server",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready for changes"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
